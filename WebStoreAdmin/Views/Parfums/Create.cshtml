@model WebStoreAdmin.ViewModels.Parfums.ParfumAjouterVM

@{
    ViewData["Title"] = "Ajouter un parfum";
}

<div class="max-w-4xl mx-auto px-8 py-12 pt-32 pb-20">

    <div class="bg-surface-container-low rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">

        <!-- En-tête -->
        <div class="p-8 border-b border-outline-variant/20">

            <h1 class="text-3xl font-headline text-tertiary">
                Ajouter un parfum
            </h1>

            <p class="mt-2 text-on-surface-variant">
                Complétez les informations et ajoutez les images du parfum.
            </p>

        </div>

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div class="p-8 space-y-6">

                <div asp-validation-summary="ModelOnly"
                     class="bg-red-100 text-red-700 rounded-lg p-4">
                </div>

                <div>
                    <label asp-for="Nom" class="block mb-2 font-medium"></label>

                    <input asp-for="Nom"
                           class="w-full rounded-lg border border-outline-variant p-3" />

                    <span asp-validation-for="Nom"
                          class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Marque" class="block mb-2 font-medium"></label>

                    <input asp-for="Marque"
                           class="w-full rounded-lg border border-outline-variant p-3" />

                    <span asp-validation-for="Marque"
                          class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Description" class="block mb-2 font-medium"></label>

                    <textarea asp-for="Description"
                              rows="4"
                              class="w-full rounded-lg border border-outline-variant p-3"></textarea>

                    <span asp-validation-for="Description"
                          class="text-red-600 text-sm"></span>
                </div>

                <div class="grid grid-cols-2 gap-6">

                    <div>

                        <label asp-for="Prix" 
                        class="block mb-2 font-medium"></label>

                        <input asp-for="Prix"
                               type="number"
                               lang="en"
                               step="any"
                               class="w-full rounded-lg border border-outline-variant p-3" />

                        <span asp-validation-for="Prix"
                              class="text-red-600 text-sm"></span>

                    </div>

                    <div class="mb-4">
    <label asp-for="Volume" class="block text-sm font-medium mb-2"></label>

    <div class="relative">
        <input asp-for="Volume"
               type="number"
               lang="en"
               step="any"
               min="1"
               class="w-full rounded-lg border border-gray-300 px-4 py-3 pr-12" />

        <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500">
            ml
        </span>
    </div>

    <span asp-validation-for="Volume"
          class="text-red-600 text-sm"></span>
</div>

                    <div>

                        <label asp-for="Stock" class="block mb-2 font-medium"></label>

                        <input asp-for="Stock"
                               class="w-full rounded-lg border border-outline-variant p-3" />

                        <span asp-validation-for="Stock"
                              class="text-red-600 text-sm"></span>

                    </div>

                </div>

                <div>

                    <label asp-for="Genre" class="block mb-2 font-medium"></label>

                    <select asp-for="Genre"
                            asp-items="Model.Genres"
                            class="w-full rounded-lg border border-outline-variant p-3">

                        <option value="">
                            -- Choisir un genre --
                        </option>

                    </select>

                    <span asp-validation-for="Genre"
                          class="text-red-600 text-sm"></span>

                </div>

                <div>

                    <label asp-for="CategorieId"
                           class="block mb-2 font-medium">
                        Catégorie
                    </label>

                    <select asp-for="CategorieId"
                            asp-items="Model.Categories"
                            class="w-full rounded-lg border border-outline-variant p-3">

                        <option value="">
                            -- Choisir une catégorie --
                        </option>

                    </select>

                    <span asp-validation-for="CategorieId"
                          class="text-red-600 text-sm"></span>

                </div>

                <div>
                    <label class="block mb-2 font-medium">Notes de tête</label>
                    <select asp-for="NotesTeteIds"
                            asp-items="Model.NotesDisponibles"
                            multiple
                            class="w-full rounded-lg border border-outline-variant p-3 h-32">
                    </select>
                    <p class="text-xs text-gray-500 mt-1">Maintiens Ctrl (ou Cmd) pour sélectionner plusieurs notes.</p>
                </div>

                <div>
                    <label class="block mb-2 font-medium">Notes de cœur</label>
                    <select asp-for="NotesCoeurIds"
                            asp-items="Model.NotesDisponibles"
                            multiple
                            class="w-full rounded-lg border border-outline-variant p-3 h-32">
                    </select>
                </div>

                <div>
                    <label class="block mb-2 font-medium">Notes de fond</label>
                    <select asp-for="NotesFondIds"
                            asp-items="Model.NotesDisponibles"
                            multiple
                            class="w-full rounded-lg border border-outline-variant p-3 h-32">
                    </select>
                </div>

                <div>

                    <label asp-for="Images"
                           class="block mb-2 font-medium"></label>

                    <input asp-for="Images"
                           id="Images"
                           type="file"
                           multiple
                           @* accept="image/*" *@
                           accept=".jpg,.jpeg,.png,.webp,.gif"
                           class="w-full rounded-lg border border-outline-variant p-3" />

                    <span asp-validation-for="Images"
                          class="text-red-600 text-sm"></span>

                </div>

                <div>

                    <label asp-for="ImagePrincipaleIndex"
                           class="block mb-2 font-medium">

                        Image principale

                    </label>

                    <select asp-for="ImagePrincipaleIndex"
                            id="imagePrincipale"
                            class="w-full rounded-lg border border-outline-variant p-3">

                        <option value="">
                            Sélectionnez une image
                        </option>

                    </select>

                </div>

            </div>

            <div class="px-8 py-6 bg-surface-container flex justify-end gap-4">

                <a asp-action="Index"
                   class="px-6 py-3 rounded-lg border border-outline-variant hover:bg-surface-container-high">

                    Annuler

                </a>

                <button type="submit"
                        class="px-6 py-3 rounded-lg bg-primary text-white hover:opacity-90">

                    Ajouter le parfum

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        const input = document.getElementById("Images");
        const select = document.getElementById("imagePrincipale");

        input.addEventListener("change", function () {

            select.innerHTML = "";

            if (this.files.length === 0) {

                select.innerHTML =
                    '<option value="">Sélectionnez une image</option>';

                return;
            }

            [...this.files].forEach((file, index) => {

                const option = document.createElement("option");

                option.value = index;
                option.text = file.name;

                select.appendChild(option);

            });

        });

    </script>
}
@model WebStoreAdmin.ViewModels.Commandes.CommandesModifierVM

@{
    ViewData["Title"] = "Modifier une commande";
}

<div class="max-w-4xl mx-auto px-8 py-12 pt-32 pb-20">

    <div class="bg-surface-container-low rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">

        <!-- Header -->
        <div class="p-8 border-b border-outline-variant/20">

            <h1 class="text-3xl font-headline text-tertiary">
                Modifier la commande
            </h1>

            <p class="mt-3 text-on-surface-variant">
                Mettez à jour les informations de cette commande.
            </p>

        </div>

        <form asp-action="Modifier" method="post">

            <div class="p-8 space-y-8">

                <div asp-validation-summary="ModelOnly"
                     class="bg-error-container text-on-error-container p-4 rounded-lg">
                </div>

                <input type="hidden" asp-for="Id" />

                <!-- Date -->
                <div>

                    <label asp-for="DateCommande"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <input asp-for="DateCommande"
                           type="date"
                           class="w-full rounded-lg border border-outline-variant
                                  bg-surface px-4 py-3
                                  focus:ring-2 focus:ring-primary
                                  focus:border-primary transition-all" />

                    <span asp-validation-for="DateCommande"
                          class="text-red-600 text-sm mt-2 block">
                    </span>

                </div>

                <div>

                    <label asp-for="Statut"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <select asp-for="Statut"
                            class="w-full rounded-lg border border-outline-variant
                   bg-surface px-4 py-3">

                        <option value="@StatutsCommande.EnAttente">En attente</option>
                        <option value="@StatutsCommande.Payee">Payée</option>
                        <option value="@StatutsCommande.Preparation">Préparation</option>
                        <option value="@StatutsCommande.Expediee">Expédiée</option>
                        <option value="@StatutsCommande.Livree">Livrée</option>
                        <option value="@StatutsCommande.Annulee">Annulée</option>

                    </select>

                </div>

                <!-- Total -->
                <div>

                    <label asp-for="Total"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <input asp-for="Total"
                           type="number"
                           step="0.01"
                           class="w-full rounded-lg border border-outline-variant
                                  bg-surface px-4 py-3
                                  focus:ring-2 focus:ring-primary
                                  focus:border-primary transition-all" />

                    <span asp-validation-for="Total"
                          class="text-red-600 text-sm mt-2 block">
                    </span>

                </div>

                <!-- Client -->
                <div>

                    <label asp-for="ClientId"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <select asp-for="ClientId"
                            asp-items="Model.Clients"
                            class="w-full rounded-lg border border-outline-variant
               bg-surface px-4 py-3
               focus:ring-2 focus:ring-primary
               focus:border-primary transition-all">

                        <option value="">
                            Sélectionnez un client
                        </option>

                    </select>

                    <span asp-validation-for="ClientId"
                          class="text-red-600 text-sm mt-2 block">
                    </span>

                </div>

            </div>

            <!-- Footer -->
            <div class="px-8 py-6 bg-surface-container flex flex-col sm:flex-row justify-end gap-4">

                <a asp-action="Index"
                   class="px-6 py-3 rounded-lg border border-outline-variant
                          hover:bg-surface-container-high transition-colors">

                    Annuler

                </a>

                <button type="submit"
                        class="px-6 py-3 rounded-lg bg-primary text-white
                               hover:opacity-90 transition-colors shadow-sm">

                    Enregistrer les modifications

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
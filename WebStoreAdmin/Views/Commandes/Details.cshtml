@model WebStoreAdmin.ViewModels.Commandes.CommandesDetailsVM

@{
    ViewData["Title"] = "Détails de la commande";
}

@{
    var badgeClass = Model.Statut switch
    {
        StatutsCommande.EnAttente => "bg-yellow-100 text-yellow-700",
        StatutsCommande.Payee => "bg-blue-100 text-blue-700",
        StatutsCommande.Preparation => "bg-purple-100 text-purple-700",
        StatutsCommande.Expediee => "bg-indigo-100 text-indigo-700",
        StatutsCommande.Livree => "bg-green-100 text-green-700",
        StatutsCommande.Annulee => "bg-red-100 text-red-700",
        _ => "bg-gray-100 text-gray-700"
    };
}

<span class="px-4 py-2 rounded-full font-medium @badgeClass">
    @Model.Statut
</span>

<div class="max-w-6xl mx-auto px-8 py-12 pt-32">

    <div class="bg-surface-container-low rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">

        <!-- Header -->
        <div class="p-8 border-b border-outline-variant/20">

            <div class="flex justify-between items-center">

                <div>

                    <h1 class="text-3xl font-headline text-tertiary">
                        <a href="c:\users\tenka\source\repos\webstoreadmin\viewmodels\clients\clientsindexvm.cs">c:\users\tenka\source\repos\webstoreadmin\viewmodels\clients\clientsindexvm.cs</a>
                        Commande #@Model.Id
                    </h1>

                    <p class="mt-2 text-on-surface-variant">
                        Informations complètes de la commande.
                    </p>

                </div>

                <span class="px-4 py-2 rounded-full font-medium @badgeClass">
                    @Model.Statut
                </span>

            </div>

        </div>

        <!-- Informations -->
        <div class="p-8">

            <div class="grid md:grid-cols-2 gap-8">

                <div>
                    <h3 class="text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                        Date de commande
                    </h3>

                    <p class="text-lg font-medium">
                        @Model.DateCommande.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>

                <div>
                    <h3 class="text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                        Total
                    </h3>

                    <p class="text-2xl font-bold text-primary">
                        @Model.Total.ToString("0.00") $
                    </p>
                </div>

                <div>
                    <h3 class="text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                        Client
                    </h3>

                    <p class="font-medium">
                        @Model.NomClient
                    </p>
                </div>

                <div>
                    <h3 class="text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                        Courriel
                    </h3>

                    <p>
                        @Model.EmailClient
                    </p>
                </div>

            </div>

        </div>

        <!-- Articles -->
        <div class="border-t border-outline-variant/20">

            <div class="p-8">

                <h2 class="text-2xl font-headline text-tertiary mb-6">
                    Articles commandés
                </h2>

                @if (Model.Lignes.Any())
                {
                    <div class="overflow-x-auto">

                        <table class="w-full">

                            <thead class="bg-surface-container">

                                <tr>

                                    <th class="px-4 py-3 text-left">
                                        Parfum
                                    </th>

                                    <th class="px-4 py-3 text-center">
                                        Quantité
                                    </th>

                                    <th class="px-4 py-3 text-right">
                                        Prix
                                    </th>

                                    <th class="px-4 py-3 text-right">
                                        Sous-total
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var ligne in Model.Lignes)
                                {
                                    <tr class="border-t border-outline-variant/20">

                                        <td class="px-4 py-4">
                                            @ligne.Parfum.Nom
                                        </td>

                                        <td class="px-4 py-4 text-center">
                                            @ligne.Quantite
                                        </td>

                                        <td class="px-4 py-4 text-right">
                                            @ligne.PrixUnitaire.ToString("0.00") $
                                        </td>

                                        <td class="px-4 py-4 text-right font-semibold">
                                            @((ligne.Quantite * ligne.PrixUnitaire).ToString("0.00")) $
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <p class="text-on-surface-variant">
                        Aucun article associé à cette commande.
                    </p>
                }

            </div>

        </div>

        <!-- Footer -->
        <div class="px-8 py-6 bg-surface-container flex justify-end gap-4">

            <a asp-action="Index"
               class="px-6 py-3 rounded-lg border border-outline-variant hover:bg-surface-container-high transition">

                Retour à la liste

            </a>

        </div>

    </div>

</div>
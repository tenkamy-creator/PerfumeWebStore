@model WebStoreAdmin.ViewModels.Clients.ClientsAjouterVM

@{
    ViewData["Title"] = "Ajouter un client";
}

<div class="max-w-4xl mx-auto px-8 py-12 pt-32 pb-20">

    <div class="bg-surface-container-low rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">

        <!-- Header -->
        <div class="p-8 border-b border-outline-variant/20">

            <h1 class="text-3xl font-headline text-tertiary">
                Ajouter un client
            </h1>

            <p class="mt-3 text-on-surface-variant">
                Créez un nouveau compte client dans la boutique.
            </p>

        </div>

        <!-- Formulaire -->
        <form asp-action="Create" method="post">

            <div class="p-8 space-y-6">

                <div asp-validation-summary="ModelOnly"
                     class="bg-error-container text-on-error-container p-4 rounded-lg">
                </div>

                <!-- Prénom -->
                <div>

                    <label asp-for="Prenom"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                    </label>

                    <input asp-for="Prenom"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary" />

                    <span asp-validation-for="Prenom"
                          class="text-red-600 text-sm">
                    </span>

                </div>

                <!-- Nom -->
                <div>

                    <label asp-for="Nom"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                    </label>

                    <input asp-for="Nom"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary" />

                    <span asp-validation-for="Nom"
                          class="text-red-600 text-sm">
                    </span>

                </div>

                <!-- Email -->
                <div>

                    <label asp-for="Email"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                    </label>

                    <input asp-for="Email"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary" />

                    <span asp-validation-for="Email"
                          class="text-red-600 text-sm">
                    </span>

                </div>

                <!-- Mot de passe -->
                <div>

                    <label asp-for="MotDePasse"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                    </label>

                    <input asp-for="MotDePasse"
                           type="password"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary" />

                    <span asp-validation-for="MotDePasse"
                          class="text-red-600 text-sm">
                    </span>

                </div>

                <!-- Confirmation -->
                <div>

                    <label asp-for="ConfirmationMotDePasse"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                    </label>

                    <input asp-for="ConfirmationMotDePasse"
                           type="password"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary" />

                    <span asp-validation-for="ConfirmationMotDePasse"
                          class="text-red-600 text-sm">
                    </span>

                </div>

            </div>

            <!-- Footer -->
            <div class="px-8 py-6 bg-surface-container flex flex-col sm:flex-row justify-end gap-4">

                <a asp-action="Index"
                   class="px-6 py-3 rounded-lg border border-outline-variant
                    hover:bg-surface-container-high transition-colors">

                    Annuler

                </a>

                <button type="submit"
                        class="px-6 py-3 rounded-lg bg-primary text-white
                    hover:opacity-90 transition shadow-sm">

                    Créer le client

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

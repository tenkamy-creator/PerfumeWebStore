@model WebStoreAdmin.ViewModels.Clients.ClientsSupprimerVM

@{
    ViewData["Title"] = "Supprimer un client";
}

<div class="max-w-3xl mx-auto px-8 py-12 pt-32 pb-20">

    <div class="bg-surface-container-low rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">

        <!-- Header -->
        <div class="p-8 border-b border-outline-variant/20">

            <h1 class="text-3xl font-headline text-red-600">
                Supprimer le client
            </h1>

            <p class="mt-3 text-on-surface-variant">
                Cette action est irréversible.
            </p>

        </div>

        <!-- Confirmation -->
        <div class="p-8">

            <div class="bg-red-50 border border-red-200 rounded-lg p-6 mb-8">

                <h2 class="text-lg font-semibold text-red-700 mb-2">
                    Êtes-vous certain de vouloir supprimer ce client ?
                </h2>

                <p class="text-red-600">
                    Toutes les informations associées à ce client seront définitivement supprimées.
                </p>

            </div>

            <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <div>
                    <dt class="text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                        Nom complet
                    </dt>
                    <dd class="text-lg text-tertiary font-medium">
                        @Model.NomComplet
                    </dd>
                </div>

                <div>
                    <dt class="text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                        Courriel
                    </dt>
                    <dd class="text-lg text-tertiary">
                        @Model.Email
                    </dd>
                </div>

                <div>
                    <dt class="text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                        Nombre de commandes
                    </dt>
                    <dd class="text-lg text-tertiary">
                        @Model.NombreCommandes
                    </dd>
                </div>

            </dl>

        </div>

        <!-- Footer -->
        <form asp-action="Supprimer" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="px-8 py-6 bg-surface-container flex flex-col sm:flex-row justify-end gap-4">

                <a asp-action="Index"
                   class="px-6 py-3 rounded-lg border border-outline-variant hover:bg-surface-container-high transition-colors">

                    Annuler

                </a>

                <button type="submit"
                        class="px-6 py-3 rounded-lg bg-red-600 text-white hover:bg-red-700 transition-colors shadow-sm">

                    Supprimer définitivement

                </button>

            </div>

        </form>

    </div>

</div>

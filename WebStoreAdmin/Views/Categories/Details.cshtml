@model WebStoreAdmin.ViewModels.Categories.CategoriesDetailsVM

@{
    ViewData["Title"] = "Détails de la catégorie";
}

<div class="max-w-5xl mx-auto px-8 py-12 pt-32 pb-20">

    <div class="bg-surface-container-low rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">

        <!-- Header -->
        <div class="p-8 border-b border-outline-variant/20">

            <div class="flex justify-between items-start">

                <div>
                    <h1 class="text-3xl font-headline text-tertiary">
                        @Model.Nom
                    </h1>

                    <p class="mt-3 text-on-surface-variant">
                        Détails de la catégorie
                    </p>
                </div>

                <span class="px-4 py-2 rounded-full text-xs uppercase tracking-widest
                             bg-secondary-container text-on-secondary-container">

                    @(Model.Parfums?.Count ?? 0) parfum(s)

                </span>

            </div>

        </div>

        <!-- Informations -->
        <div class="p-8 space-y-8">

            <div>

                <h2 class="text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    Description
                </h2>

                <p class="text-on-surface leading-relaxed">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                                        ? "Aucune description disponible."
                                        : Model.Description)
                </p>

            </div>

            <div>

                <h2 class="text-sm uppercase tracking-widest text-on-surface-variant mb-6">
                    Parfums associés
                </h2>

                @if (Model.Parfums != null && Model.Parfums.Any())
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                        @foreach (var parfum in Model.Parfums)
                        {
                            <div class="bg-surface-container rounded-lg p-4 border border-outline-variant/20">

                                <h3 class="font-semibold text-tertiary">
                                    @parfum.Nom
                                </h3>

                                <p class="text-sm text-on-surface-variant mt-1">
                                    @parfum.Marque
                                </p>

                                <p class="text-primary font-medium mt-2">
                                    @parfum.Prix.ToString("0.00") $
                                </p>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="bg-surface-container rounded-lg p-6 text-center text-on-surface-variant">
                        Aucun parfum associé à cette catégorie.
                    </div>
                }

            </div>

        </div>

        <!-- Footer -->
        <div class="px-8 py-6 bg-surface-container flex flex-col sm:flex-row justify-end gap-4">

            <a asp-action="Index"
               class="px-6 py-3 rounded-lg border border-outline-variant
                      hover:bg-surface-container-high transition-colors">

                Retour

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="px-6 py-3 rounded-lg bg-primary text-white
                      hover:opacity-90 transition-colors">

                Modifier

            </a>

        </div>

    </div>

</div>
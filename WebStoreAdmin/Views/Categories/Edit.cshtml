@model WebStoreAdmin.ViewModels.Categories.CategorieModifierVM

@{
    ViewData["Title"] = "Modifier une catégorie";
}

<div class="max-w-4xl mx-auto px-8 py-12 pt-32 pb-20">

    <div class="bg-surface-container-low rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">

        <!-- Header -->
        <div class="p-8 border-b border-outline-variant/20">

            <h1 class="text-3xl font-headline text-tertiary">
                Modifier la catégorie
            </h1>

            <p class="mt-3 text-on-surface-variant">
                Mettez à jour les informations de cette catégorie.
            </p>

        </div>

        <!-- Formulaire -->
        <form asp-action="Edit" method="post">

            <div class="p-8 space-y-8">

                <div asp-validation-summary="ModelOnly"
                     class="bg-error-container text-on-error-container p-4 rounded-lg">
                </div>

                <input type="hidden" asp-for="Id" />

                <!-- Nom -->
                <div>

                    <label asp-for="Nom"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <input asp-for="Nom"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary transition-all" />

                    <span asp-validation-for="Nom"
                          class="text-red-600 text-sm mt-2 block">
                    </span>

                </div>

                <!-- Description -->
                <div>

                    <label asp-for="Description"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <textarea asp-for="Description"
                              rows="5"
                              class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary transition-all">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-red-600 text-sm mt-2 block">
                </span>

            </div>

            <!-- Parfums -->
            @if (Model.Parfums != null && Model.Parfums.Any())
            {
                <div>

                    <label class="block text-sm uppercase tracking-widest text-on-surface-variant mb-4">
                        Parfums associés
                    </label>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 max-h-72 overflow-y-auto p-4 rounded-lg border border-outline-variant/20 bg-surface">

                        @foreach (var parfum in Model.Parfums)
                        {
                            <label class="flex items-center gap-3 cursor-pointer">

                                <input type="checkbox"
                                       name="ParfumsIds"
                                       value="@parfum.Value"
                                       checked="@(Model.ParfumsIds?.Contains(int.Parse(parfum.Value)) == true ? "checked" : null)"
                                       class="rounded border-outline-variant text-primary focus:ring-primary" />

                                <span class="text-on-surface">
                                    @parfum.Text
                                </span>

                            </label>
                        }

                    </div>

                </div>
            }

        </div>

        <!-- Footer -->
        <div class="px-8 py-6 bg-surface-container flex flex-col sm:flex-row justify-end gap-4">

            <a asp-action="Index"
               class="px-6 py-3 rounded-lg border border-outline-variant
                hover:bg-surface-container-high transition-colors">

                Annuler

            </a>

            <button type="submit"
                    class="px-6 py-3 rounded-lg bg-primary text-white
                hover:opacity-90 transition-colors shadow-sm">

                Enregistrer les modifications

            </button>

        </div>

    </form>

</div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

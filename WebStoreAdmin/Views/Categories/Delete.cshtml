@model WebStoreAdmin.ViewModels.Categories.CategoriesSupprimerVM

@{
    ViewData["Title"] = "Supprimer une catégorie";
}

<div class="max-w-3xl mx-auto px-8 py-12 pt-32 pb-20">

    <div class="bg-surface-container-low rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">

        <!-- Header -->
        <div class="p-8 border-b border-outline-variant/20">
            <h1 class="text-3xl font-headline text-tertiary">
                Supprimer la catégorie
            </h1>

            <p class="mt-3 text-on-surface-variant">
                Cette action est irréversible.
            </p>
        </div>

        <!-- Contenu -->
        <div class="p-8">

            <div class="bg-error-container/30 border border-red-200 rounded-lg p-5 mb-8">
                <h2 class="text-lg font-semibold text-red-700 mb-2">
                    Confirmation requise
                </h2>

                <p class="text-sm text-red-600">
                    Êtes-vous certain de vouloir supprimer cette catégorie ?
                </p>
            </div>

            <dl class="grid grid-cols-1 md:grid-cols-3 gap-6">

                <div>
                    <dt class="text-xs uppercase tracking-widest text-on-surface-variant mb-2">
                        Nom
                    </dt>

                    <dd class="text-lg font-medium text-tertiary">
                        @Model.Nom
                    </dd>
                </div>

            </dl>

        </div>

        <!-- Footer -->
        <div class="px-8 py-6 bg-surface-container flex flex-col sm:flex-row justify-end gap-4">

            <a asp-action="Index"
               class="px-6 py-3 rounded-lg border border-outline-variant
                text-on-surface hover:bg-surface-container-high
                transition-colors text-center">

                Annuler

            </a>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="px-6 py-3 rounded-lg
                    bg-red-600 text-white
                    hover:bg-red-700
                    transition-colors
                    shadow-sm">

                    Supprimer définitivement

                </button>

            </form>

        </div>

    </div>

</div>

@model WebStoreAdmin.ViewModels.Employes.EmployesAjouterVM

@{
    ViewData["Title"] = "Ajouter un employé";
}

<div class="max-w-4xl mx-auto px-8 py-12 pt-32 pb-20">

    <div class="bg-surface-container-low rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">

        <!-- Header -->
        <div class="p-8 border-b border-outline-variant/20">

            <h1 class="text-3xl font-headline text-tertiary">
                Ajouter un employé
            </h1>

            <p class="mt-3 text-on-surface-variant">
                Créez un nouveau compte employé et attribuez-lui un rôle.
            </p>

        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div class="p-8 space-y-8">

                <div asp-validation-summary="ModelOnly"
                     class="bg-red-100 text-red-700 p-4 rounded-lg">
                </div>

                <!-- Photo -->
                <div>

                    <label asp-for="Photo"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <input asp-for="Photo"
                           type="file"
                           accept="image/png, image/jpeg, image/webp"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary transition-all" />

                    <p class="text-xs text-outline mt-2">Optionnel — JPG, PNG ou WEBP, 5 Mo maximum.</p>

                    <span asp-validation-for="Photo"
                          class="text-red-600 text-sm mt-2 block">
                    </span>

                </div>

                <!-- Prénom -->
                <div>

                    <label asp-for="Prenom"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <input asp-for="Prenom"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary transition-all" />

                    <span asp-validation-for="Prenom"
                          class="text-red-600 text-sm mt-2 block">
                    </span>

                </div>

                <!-- Nom -->
                <div>

                    <label asp-for="Nom"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <input asp-for="Nom"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary transition-all" />

                    <span asp-validation-for="Nom"
                          class="text-red-600 text-sm mt-2 block">
                    </span>

                </div>

                <!-- Courriel -->
                <div>

                    <label asp-for="Email"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary transition-all" />

                    <span asp-validation-for="Email"
                          class="text-red-600 text-sm mt-2 block">
                    </span>

                </div>

                <!-- Mot de passe -->
                <div>

                    <label asp-for="MotDePasse"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <input asp-for="MotDePasse"
                           type="password"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary transition-all" />

                    <span asp-validation-for="MotDePasse"
                          class="text-red-600 text-sm mt-2 block">
                    </span>

                </div>

                <!-- Poste -->
                <div>

                    <label asp-for="Poste"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <input asp-for="Poste"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary transition-all" />

                    <span asp-validation-for="Poste"
                          class="text-red-600 text-sm mt-2 block">
                    </span>

                </div>

                <!-- Département -->
                <div>

                    <label asp-for="Departement"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <input asp-for="Departement"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary transition-all" />

                    <span asp-validation-for="Departement"
                          class="text-red-600 text-sm mt-2 block">
                    </span>

                </div>

                <!-- Date d'embauche -->
                <div>

                    <label asp-for="DateEmbauche"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <input asp-for="DateEmbauche"
                           type="date"
                           class="w-full rounded-lg border border-outline-variant
                    bg-surface px-4 py-3
                    focus:ring-2 focus:ring-primary
                    focus:border-primary transition-all" />

                    <span asp-validation-for="DateEmbauche"
                          class="text-red-600 text-sm mt-2 block">
                    </span>

                </div>

                <!-- Rôle -->
                <div>

                    <label asp-for="Role"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-3">
                    </label>

                    <select asp-for="Role"
                            asp-items="Model.Roles"
                            class="w-full rounded-lg border border-outline-variant
                        bg-surface px-4 py-3
                        focus:ring-2 focus:ring-primary
                        focus:border-primary transition-all">

                        <option value="">
                            Sélectionnez un rôle
                        </option>

                    </select>

                    <span asp-validation-for="Role"
                          class="text-red-600 text-sm mt-2 block">
                    </span>

                </div>

            </div>

            <!-- Footer -->
            <div class="px-8 py-6 bg-surface-container flex flex-col sm:flex-row justify-end gap-4">

                <a asp-action="Index"
                   class="px-6 py-3 rounded-lg border border-outline-variant
                    hover:bg-surface-container-high transition-colors">

                    Annuler

                </a>

                <button type="submit"
                        class="px-6 py-3 rounded-lg bg-primary text-white
                    hover:opacity-90 transition-colors shadow-sm">

                    Ajouter l'employé

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@model IEnumerable<WebStoreAdmin.ViewModels.Employes.EmployesIndexVM>

@{
    ViewData["Title"] = "Employés";
}

<div class="max-w-7xl mx-auto px-8 py-12 pt-32">

    <div class="flex flex-col md:flex-row justify-between items-center mb-8">

        <div>
            <h1 class="text-4xl font-headline text-tertiary">
                Gestion des employés
            </h1>

            <p class="mt-2 text-on-surface-variant">
                Consultez et gérez les employés de la boutique.
            </p>
        </div>

        <a asp-action="Create"
           class="mt-4 md:mt-0 px-6 py-3 rounded-lg bg-primary text-white hover:opacity-90 transition">

            Nouvel employé

        </a>

    </div>

    <div class="bg-surface-container-low rounded-xl shadow-sm overflow-hidden border border-outline-variant/20">

        <table class="w-full">

            <thead class="bg-surface-container">

                <tr class="text-left">

                    <th class="px-6 py-4">
                        Photo
                    </th>

                    <th class="px-6 py-4">
                        Nom complet
                    </th>

                    <th class="px-6 py-4">
                        Courriel
                    </th>

                    <th class="px-6 py-4">
                        Poste
                    </th>

                    <th class="px-6 py-4">
                        Département
                    </th>

                    <th class="px-6 py-4">
                        Date d'embauche
                    </th>

                    <th class="px-6 py-4 text-center">
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr class="border-t border-outline-variant/20 hover:bg-surface-container-high transition">

                        <td class="px-6 py-4">
                            @if (!string.IsNullOrEmpty(item.PhotoUrl))
                            {
                                <img src="@item.PhotoUrl"
                                     alt="@item.NomComplet"
                                     class="w-10 h-10 rounded-full object-cover" />
                            }
                            else
                            {
                                <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-xs uppercase text-on-surface-variant">
                                    @item.NomComplet.Substring(0, 1)
                                </div>
                            }
                        </td>

                        <td class="px-6 py-4 font-medium">
                            @item.NomComplet
                        </td>

                        <td class="px-6 py-4">
                            @item.Email
                        </td>

                        <td class="px-6 py-4">
                            @item.Poste
                        </td>

                        <td class="px-6 py-4">
                            @item.Departement
                        </td>

                        <td class="px-6 py-4">
                            @item.DateEmbauche.ToString("dd/MM/yyyy")
                        </td>

                        <td class="px-6 py-4">

                            <div class="flex justify-center gap-2">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="px-3 py-2 rounded-lg bg-blue-100 text-blue-700 hover:bg-blue-200">

                                    Détails

                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="px-3 py-2 rounded-lg bg-amber-100 text-amber-700 hover:bg-amber-200">

                                    Modifier

                                </a>

                                <a asp-action="Supprimer"
                                   asp-route-id="@item.Id"
                                   class="px-3 py-2 rounded-lg bg-red-100 text-red-700 hover:bg-red-200">

                                    Supprimer

                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div class="flex items-center justify-between pt-4 border-t border-outline-variant/20">
        <a asp-controller="Home" asp-action="Index"
           class="font-label text-xs uppercase tracking-widest text-outline hover:text-tertiary transition-colors">
            &larr; Retour à l'accueil
        </a>
    </div>

</div>

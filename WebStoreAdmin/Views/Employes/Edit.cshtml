@model WebStoreAdmin.ViewModels.Employes.EmployesModifierVM

@{
    ViewData["Title"] = "Modifier un employé";
}

<div class="max-w-4xl mx-auto px-8 py-12 pt-32 pb-20">

    <div class="bg-surface-container-low rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">

        <!-- Header -->
        <div class="p-8 border-b border-outline-variant/20">

            <h1 class="text-3xl font-headline text-tertiary">
                Modifier l'employé
            </h1>

            <p class="mt-3 text-on-surface-variant">
                Mettez à jour les informations de l'employé.
            </p>

        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">

            <div class="p-8 space-y-6">

                <div asp-validation-summary="ModelOnly"
                     class="bg-red-100 text-red-700 rounded-lg p-4">
                </div>

                <input type="hidden" asp-for="Id" />

                <!-- Photo -->
                <div>
                    <label asp-for="Photo"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                    </label>

                    <div class="flex items-center gap-4 mb-3">
                        @if (!string.IsNullOrEmpty(Model.PhotoUrlActuelle))
                        {
                            <img src="@Model.PhotoUrlActuelle"
                                 alt="Photo actuelle de @Model.Prenom @Model.Nom"
                                 class="w-16 h-16 rounded-full object-cover border border-outline-variant/30" />
                        }
                        else
                        {
                            <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant text-xs uppercase">
                                Aucune
                            </div>
                        }
                        <span class="text-sm text-on-surface-variant">
                            @(string.IsNullOrEmpty(Model.PhotoUrlActuelle) ? "Aucune photo actuellement" : "Photo actuelle — sélectionnez un fichier pour la remplacer")
                        </span>
                    </div>

                    <input asp-for="Photo"
                           type="file"
                           accept="image/png, image/jpeg, image/webp"
                           class="w-full rounded-lg border border-outline-variant px-4 py-3 bg-surface focus:ring-2 focus:ring-primary focus:border-primary" />

                    <p class="text-xs text-outline mt-2">Optionnel — laissez vide pour conserver la photo actuelle. JPG, PNG ou WEBP, 5 Mo maximum.</p>

                    <span asp-validation-for="Photo"
                          class="text-red-600 text-sm">
                    </span>
                </div>

                <!-- Prénom -->
                <div>
                    <label asp-for="Prenom"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                    </label>

                    <input asp-for="Prenom"
                           class="w-full rounded-lg border border-outline-variant px-4 py-3 bg-surface focus:ring-2 focus:ring-primary focus:border-primary" />

                    <span asp-validation-for="Prenom"
                          class="text-red-600 text-sm">
                    </span>
                </div>

                <!-- Nom -->
                <div>
                    <label asp-for="Nom"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                    </label>

                    <input asp-for="Nom"
                           class="w-full rounded-lg border border-outline-variant px-4 py-3 bg-surface focus:ring-2 focus:ring-primary focus:border-primary" />

                    <span asp-validation-for="Nom"
                          class="text-red-600 text-sm">
                    </span>
                </div>

                <!-- Courriel -->
                <div>
                    <label asp-for="Email"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                    </label>

                    <input asp-for="Email"
                           class="w-full rounded-lg border border-outline-variant px-4 py-3 bg-surface focus:ring-2 focus:ring-primary focus:border-primary" />

                    <span asp-validation-for="Email"
                          class="text-red-600 text-sm">
                    </span>
                </div>

                <!-- Poste -->
                <div>
                    <label asp-for="Poste"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                    </label>

                    <input asp-for="Poste"
                           class="w-full rounded-lg border border-outline-variant px-4 py-3 bg-surface focus:ring-2 focus:ring-primary focus:border-primary" />

                    <span asp-validation-for="Poste"
                          class="text-red-600 text-sm">
                    </span>
                </div>

                <!-- Département -->
                <div>
                    <label asp-for="Departement"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                    </label>

                    <input asp-for="Departement"
                           class="w-full rounded-lg border border-outline-variant px-4 py-3 bg-surface focus:ring-2 focus:ring-primary focus:border-primary" />

                    <span asp-validation-for="Departement"
                          class="text-red-600 text-sm">
                    </span>
                </div>

                <!-- Date embauche -->
                <div>
                    <label asp-for="DateEmbauche"
                           class="block text-sm uppercase tracking-widest text-on-surface-variant mb-2">
                    </label>

                    <input asp-for="DateEmbauche"
                           type="date"
                           class="w-full rounded-lg border border-outline-variant px-4 py-3 bg-surface focus:ring-2 focus:ring-primary focus:border-primary" />

                    <span asp-validation-for="DateEmbauche"
                          class="text-red-600 text-sm">
                    </span>
                </div>

            </div>

            <!-- Footer -->
            <div class="px-8 py-6 bg-surface-container flex flex-col sm:flex-row justify-end gap-4">

                <a asp-action="Index"
                   class="px-6 py-3 rounded-lg border border-outline-variant hover:bg-surface-container-high transition">

                    Annuler

                </a>

                <button type="submit"
                        class="px-6 py-3 rounded-lg bg-primary text-white hover:opacity-90 transition shadow-sm">

                    Enregistrer les modifications

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@model WebStoreAdmin.ViewModels.FamilleOlfactive.FamilleOlfactiveSupprimerVM

@{
    ViewData["Title"] = "Supprimer une famille olfactive";
}

<div class="max-w-2xl mx-auto px-8 py-12 pt-32 pb-20">

    <div class="bg-surface-container-low rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">

        <div class="p-8 border-b border-outline-variant/20">
            <h1 class="text-3xl font-headline text-red-600">Supprimer la famille olfactive</h1>
            <p class="mt-3 text-on-surface-variant">Cette action est irréversible.</p>
        </div>

        <div class="p-8">

            <div class="bg-red-50 border border-red-200 rounded-lg p-5 mb-8">
                <p class="text-red-700 font-medium">Êtes-vous certain de vouloir supprimer cette famille ?</p>
                @if (Model.NombreNotes > 0)
                {
                    <p class="text-sm text-red-600 mt-2">
                        Attention : @Model.NombreNotes note(s) olfactive(s) sont actuellement rattachées à cette famille. Elles resteront, mais sans famille associée.
                    </p>
                }
            </div>

            <div class="flex items-center gap-4">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Nom" class="w-16 h-16 rounded-lg object-cover" />
                }
                <div>
                    <dt class="text-xs uppercase tracking-widest text-on-surface-variant mb-1">Nom</dt>
                    <dd class="text-lg font-medium text-tertiary">@Model.Nom</dd>
                </div>
            </div>

        </div>

        <div class="px-8 py-6 bg-surface-container flex flex-col sm:flex-row justify-end gap-4">

            <a asp-action="Index" class="px-6 py-3 rounded-lg border border-outline-variant hover:bg-surface-container-high transition-colors">
                Annuler
            </a>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="px-6 py-3 rounded-lg bg-red-600 text-white hover:bg-red-700 transition-colors shadow-sm">
                    Supprimer définitivement
                </button>
            </form>

        </div>

    </div>

</div>

@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Mot de passe réinitialisé";
}

<main class="min-h-[70vh] flex items-center justify-center px-6 pt-32 pb-20 bg-background">
    <div class="w-full max-w-md bg-surface-container-low rounded-xl shadow-xl p-10 border border-outline-variant/20 text-center">
        <span class="material-symbols-outlined text-6xl text-primary mb-4">check_circle</span>
        <h1 class="font-headline text-3xl text-tertiary mb-4">@ViewData["Title"]</h1>
        <p class="text-on-surface-variant">
            Votre mot de passe a été réinitialisé.
            <a asp-page="./Login" class="text-primary hover:underline">Cliquez ici pour vous connecter</a>.
        </p>
    </div>
</main>

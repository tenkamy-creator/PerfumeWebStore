@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirmation du courriel";
}

<main class="min-h-[70vh] flex items-center justify-center px-6 pt-32 pb-20 bg-background">
    <div class="w-full max-w-md bg-surface-container-low rounded-xl shadow-xl p-10 border border-outline-variant/20 text-center">
        <span class="material-symbols-outlined text-6xl text-primary mb-4">mark_email_read</span>
        <h1 class="font-headline text-3xl text-tertiary mb-6">@ViewData["Title"]</h1>
        <partial name="_StatusMessage" model="Model.StatusMessage" />
    </div>
</main>

@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Mot de passe oublié";
}

<main class="pt-32 pb-24 bg-surface min-h-screen">
    <div class="max-w-md mx-auto px-6">

        <div class="text-center mb-10">
            <p class="font-label text-xs uppercase tracking-[0.3em] text-secondary mb-3">Compte</p>
            <h1 class="font-headline text-4xl text-tertiary">Mot de passe oublié ?</h1>
            <p class="mt-3 text-on-surface-variant">
                Entrez votre adresse courriel pour recevoir un lien de réinitialisation.
            </p>
        </div>

        <div class="bg-surface-container-low rounded-lg border border-outline-variant/20 p-8 shadow-sm">
            <form method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm" role="alert"></div>

                <div>
                    <label asp-for="Input.Email" class="block font-label text-[10px] uppercase tracking-widest text-outline mb-2"></label>
                    <input asp-for="Input.Email"
                           class="w-full rounded-lg border border-outline-variant/30 bg-surface px-4 py-3 text-tertiary placeholder:text-outline/50 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="nom@exemple.com" />
                    <span asp-validation-for="Input.Email" class="block mt-2 text-sm text-red-600"></span>
                </div>

                <button type="submit"
                        class="w-full bg-gradient-to-br from-primary to-primary-container text-on-primary py-4 rounded-lg font-label uppercase tracking-[0.2em] text-sm shadow-lg shadow-primary/10 hover:shadow-primary/20 transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0">
                    Envoyer le lien de réinitialisation
                </button>
            </form>
        </div>

        <p class="text-center mt-8 text-sm text-on-surface-variant">
            <a asp-page="./Login" class="text-primary hover:underline">Retour à la connexion</a>
        </p>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

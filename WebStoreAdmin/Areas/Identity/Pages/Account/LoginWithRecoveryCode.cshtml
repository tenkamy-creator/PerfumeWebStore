@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Vérification du code de récupération";
}

<main class="min-h-screen flex items-center justify-center px-6 pt-32 pb-20 bg-background">
    <div class="w-full max-w-md bg-surface-container-low rounded-xl shadow-xl p-10 border border-outline-variant/20">

        <div class="text-center mb-8">
            <h1 class="font-headline text-3xl text-tertiary mb-3">@ViewData["Title"]</h1>
            <p class="text-on-surface-variant text-sm">
                Vous avez demandé à vous connecter avec un code de récupération. Cette connexion ne sera pas mémorisée
                tant que vous n'aurez pas fourni un code d'application d'authentification ou désactivé la 2FA.
            </p>
        </div>

        <form method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm" role="alert"></div>

            <div>
                <label asp-for="Input.RecoveryCode" class="block font-label text-[10px] uppercase tracking-widest text-outline mb-2"></label>
                <input asp-for="Input.RecoveryCode"
                       autocomplete="off"
                       placeholder="Code de récupération"
                       class="w-full rounded-lg border border-outline-variant/30 bg-surface px-4 py-3 text-tertiary placeholder:text-outline/50 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all" />
                <span asp-validation-for="Input.RecoveryCode" class="block mt-2 text-sm text-red-600"></span>
            </div>

            <button type="submit"
                    class="w-full bg-gradient-to-br from-primary to-primary-container text-on-primary py-4 rounded-lg font-label uppercase tracking-[0.2em] text-sm shadow-lg shadow-primary/10 hover:shadow-primary/20 transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0">
                Se connecter
            </button>
        </form>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Changer le mot de passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h2 class="font-headline text-2xl text-tertiary mb-2">@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" class="space-y-6 max-w-lg mt-6">
    <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm" role="alert"></div>

    <div>
        <label asp-for="Input.OldPassword" class="block font-label text-[10px] uppercase tracking-widest text-outline mb-2"></label>
        <input asp-for="Input.OldPassword"
               autocomplete="current-password"
               aria-required="true"
               placeholder="Mot de passe actuel"
               class="w-full rounded-lg border border-outline-variant/30 bg-surface px-4 py-3 text-tertiary placeholder:text-outline/50 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all" />
        <span asp-validation-for="Input.OldPassword" class="block mt-2 text-sm text-red-600"></span>
    </div>

    <div>
        <label asp-for="Input.NewPassword" class="block font-label text-[10px] uppercase tracking-widest text-outline mb-2"></label>
        <input asp-for="Input.NewPassword"
               autocomplete="new-password"
               aria-required="true"
               placeholder="Nouveau mot de passe"
               class="w-full rounded-lg border border-outline-variant/30 bg-surface px-4 py-3 text-tertiary placeholder:text-outline/50 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all" />
        <span asp-validation-for="Input.NewPassword" class="block mt-2 text-sm text-red-600"></span>
    </div>

    <div>
        <label asp-for="Input.ConfirmPassword" class="block font-label text-[10px] uppercase tracking-widest text-outline mb-2"></label>
        <input asp-for="Input.ConfirmPassword"
               autocomplete="new-password"
               aria-required="true"
               placeholder="Confirmer le nouveau mot de passe"
               class="w-full rounded-lg border border-outline-variant/30 bg-surface px-4 py-3 text-tertiary placeholder:text-outline/50 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all" />
        <span asp-validation-for="Input.ConfirmPassword" class="block mt-2 text-sm text-red-600"></span>
    </div>

    <button type="submit"
            class="bg-gradient-to-br from-primary to-primary-container text-on-primary py-3 px-8 rounded-lg font-label uppercase tracking-[0.2em] text-sm shadow-lg shadow-primary/10 hover:shadow-primary/20 transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0">
        Mettre à jour le mot de passe
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

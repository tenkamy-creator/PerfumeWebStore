@page
@model EmailModel
@{
    ViewData["Title"] = "Gérer le courriel";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h2 class="font-headline text-2xl text-tertiary mb-2">@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post" class="space-y-6 max-w-lg mt-6">
    <div asp-validation-summary="All" class="text-red-600 text-sm" role="alert"></div>

    @if (Model.IsEmailConfirmed)
    {
        <div>
            <label asp-for="Email" class="block font-label text-[10px] uppercase tracking-widest text-outline mb-2"></label>
            <div class="flex items-center gap-3">
                <input asp-for="Email"
                       disabled
                       class="w-full rounded-lg border border-outline-variant/30 bg-surface-container px-4 py-3 text-on-surface-variant cursor-not-allowed" />
                <span class="text-green-600 font-bold text-lg" title="Courriel confirmé">✓</span>
            </div>
        </div>
    }
    else
    {
        <div>
            <label asp-for="Email" class="block font-label text-[10px] uppercase tracking-widest text-outline mb-2"></label>
            <input asp-for="Email"
                   disabled
                   class="w-full rounded-lg border border-outline-variant/30 bg-surface-container px-4 py-3 text-on-surface-variant cursor-not-allowed mb-2" />
            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail"
                    class="text-primary text-sm hover:underline">
                Envoyer un courriel de vérification
            </button>
        </div>
    }

    <div>
        <label asp-for="Input.NewEmail" class="block font-label text-[10px] uppercase tracking-widest text-outline mb-2"></label>
        <input asp-for="Input.NewEmail"
               autocomplete="email"
               aria-required="true"
               placeholder="Nouvelle adresse courriel"
               class="w-full rounded-lg border border-outline-variant/30 bg-surface px-4 py-3 text-tertiary placeholder:text-outline/50 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all" />
        <span asp-validation-for="Input.NewEmail" class="block mt-2 text-sm text-red-600"></span>
    </div>

    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail"
            class="bg-gradient-to-br from-primary to-primary-container text-on-primary py-3 px-8 rounded-lg font-label uppercase tracking-[0.2em] text-sm shadow-lg shadow-primary/10 hover:shadow-primary/20 transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0">
        Changer le courriel
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

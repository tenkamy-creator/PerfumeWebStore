@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Supprimer les données personnelles";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2 class="font-headline text-2xl text-tertiary mb-6">@ViewData["Title"]</h2>

<div class="bg-red-50 border border-red-200 text-red-700 rounded-lg p-4 mb-8" role="alert">
    <p class="font-medium">
        La suppression de ces données supprimera définitivement votre compte, et cette action est irréversible.
    </p>
</div>

<form id="delete-user" method="post" class="max-w-md space-y-6">
    <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm" role="alert"></div>

    @if (Model.RequirePassword)
    {
        <div>
            <label asp-for="Input.Password" class="block font-label text-[10px] uppercase tracking-widest text-outline mb-2"></label>
            <input asp-for="Input.Password"
                   autocomplete="current-password"
                   aria-required="true"
                   placeholder="Entrez votre mot de passe"
                   class="w-full rounded-lg border border-outline-variant/30 bg-surface px-4 py-3 text-tertiary placeholder:text-outline/50 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all" />
            <span asp-validation-for="Input.Password" class="block mt-2 text-sm text-red-600"></span>
        </div>
    }

    <button type="submit"
            class="w-full px-6 py-4 rounded-lg bg-red-600 text-white font-label uppercase tracking-[0.2em] text-sm hover:bg-red-700 transition-colors">
        Supprimer mes données et fermer mon compte
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

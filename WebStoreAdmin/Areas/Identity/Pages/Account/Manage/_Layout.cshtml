@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<main class="pt-32 pb-24 bg-surface min-h-screen">
    <div class="max-w-5xl mx-auto px-6">

        <div class="mb-10">
            <p class="font-label text-xs uppercase tracking-[0.3em] text-secondary mb-3">Mon compte</p>
            <h1 class="font-headline text-4xl text-tertiary">Gérer votre compte</h1>
            <p class="mt-3 text-on-surface-variant">Mettez à jour vos informations et vos préférences de sécurité.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">

            <div class="md:col-span-3">
                <div class="bg-surface-container-low rounded-lg border border-outline-variant/20 p-4">
                    <partial name="_ManageNav" />
                </div>
            </div>

            <div class="md:col-span-9">
                <div class="bg-surface-container-low rounded-lg border border-outline-variant/20 p-8 shadow-sm">
                    @RenderBody()
                </div>
            </div>

        </div>

    </div>
</main>

@section Scripts {
    @RenderSection("Scripts", required: false)
}

@page
@model Disable2faModel
@{
    ViewData["Title"] = "Désactiver l'authentification à deux facteurs (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2 class="font-headline text-2xl text-tertiary mb-6">@ViewData["Title"]</h2>

<div class="bg-amber-50 border border-amber-200 text-amber-700 rounded-lg p-4 mb-8" role="alert">
    <p class="font-medium mb-2">Cette action désactive uniquement la 2FA.</p>
    <p class="text-sm">
        Désactiver la 2FA ne modifie pas les clés utilisées dans les applications d'authentification.
        Si vous souhaitez changer la clé utilisée, vous devriez
        <a asp-page="./ResetAuthenticator" class="underline">réinitialiser vos clés d'authentification</a>.
    </p>
</div>

<form method="post">
    <button type="submit"
            class="px-6 py-3 rounded-lg bg-red-600 text-white hover:bg-red-700 transition-colors">
        Désactiver la 2FA
    </button>
</form>
